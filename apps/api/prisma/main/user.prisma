model User {
  id           String            @id @default(uuid())
  email        String            @unique
  first_name   String
  last_name    String
  passwordHash String
  // gamification Stats
  level        Int               @default(1)
  xp           Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  // relations
  transactions Transaction[]
  categories   Category[]
  budgets      Budget[]
  achievements UserAchievement[]
}
