// --- BUDGET ENTITY ---
model Budget {
  id         String   @id @default(uuid())
  amount     Float // The spending limit
  month      Int // 1-12
  year       Int
  // relations
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, categoryId, month, year])
}
